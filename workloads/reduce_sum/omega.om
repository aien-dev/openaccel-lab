global kn ulong 1
fn kern to void
s = 0.0f32
for i ulong get kn 0
s = add s get fa i
end
put fo 0 s
end
fn main to int
oal_begin
put kn 0 ulong oal_p 0
a = oal_fa 0
w = oal_warm
for i ulong add w oal_reps
t0 = monons
kern
t1 = monons
if ge i w
oal_tick sub t1 t0
end
end
oal_so 0 1
oal_end
ret 0
end
