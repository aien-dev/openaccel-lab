note saxpy: fo[i] = alpha * fb[i] + fc[i]; alpha is fa[0]; a separate mul then add (two roundings)
global kn ulong 1
fn kern to void
al = get fa 0
for i ulong get kn 0
put fo i add mul al get fb i get fc i
end
end
fn main to int
oal_begin
put kn 0 ulong oal_p 0
a = oal_fa 0
b = oal_fb 1
c = oal_fc 2
w = oal_warm
for i ulong add w oal_reps
t0 = monons
kern
t1 = monons
if ge i w
oal_tick sub t1 t0
end
end
oal_so 0 get kn 0
oal_end
ret 0
end
