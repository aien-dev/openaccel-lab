global kn ulong 1
fn kern to void
for i ulong get kn 0
put fo i add get fa i get fb i
end
end
fn main to int
oal_begin
put kn 0 ulong oal_p 0
a = oal_fa 0
b = oal_fb 1
w = oal_warm
for i ulong add w oal_reps
t0 = monons
kern
t1 = monons
if ge i w
oal_tick sub t1 t0
end
end
oal_so 0 get kn 0
oal_end
ret 0
end
