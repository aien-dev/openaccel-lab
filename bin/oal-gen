#!/usr/bin/env python3
# SPDX-License-Identifier: Apache-2.0
# oal-gen WORKLOAD [--seed S] [--set k=v ...] > case.bin
# Write one case container (docs/CONTAINER.md) for WORKLOAD to stdout. Exit 0, or 2 on a usage error.
# INTERIM host glue (Python). Successor: oal-gen in seeded Omega.
import os
import sys
sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.realpath(__file__))))
import argparse
from oal import manifest, matrix

ap = argparse.ArgumentParser(prog="oal-gen")
ap.add_argument("workload")
ap.add_argument("--seed", type=int, default=1)
ap.add_argument("--set", action="append", default=[], metavar="K=V")
a = ap.parse_args()
m = manifest.load(a.workload)
over = dict(kv.split("=", 1) for kv in a.set)
params, _, blob = matrix.make_case(m, over, a.seed)
sys.stderr.write("oal-gen %s seed %d params %s bytes %d\n" % (a.workload, a.seed, params, len(blob)))
sys.stdout.buffer.write(blob)
