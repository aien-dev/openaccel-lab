global kr ulong 1
global kc ulong 1
fn kern to void
r = get kr 0
c = get kc 0
for i ulong r
b = mul i c
sc = get fa i
for j ulong c
o = add b j
v = f32 get qa o
put fo o mul v sc
end
end
end
fn main to int
oal_begin
put kr 0 ulong oal_p 0
put kc 0 ulong oal_p 1
n = oal_qa 0
a = oal_fa 1
w = oal_warm
for i ulong add w oal_reps
t0 = monons
kern
t1 = monons
if ge i w
oal_tick sub t1 t0
end
end
oal_so 0 mul get kr 0 get kc 0
oal_end
ret 0
end
