note silu: y = x / (1 + exp(-x)) in f32; exp via oal_expf in binary64, rounded once to f32
global kn ulong 1
fn kern to void
for i ulong get kn 0
v = get fa i
e = f32 oal_expf f64 neg v
put fo i div v add 1.0f32 e
end
end
fn main to int
oal_begin
put kn 0 ulong oal_p 0
a = oal_fa 0
w = oal_warm
for i ulong add w oal_reps
t0 = monons
kern
t1 = monons
if ge i w
oal_tick sub t1 t0
end
end
oal_so 0 get kn 0
oal_end
ret 0
end
