note softmax over rows of x[R][D] in f32: e = exp(x - max) via oal_expf rounded to f32, y = e / sum e
global kr ulong 1
global kd ulong 1
fn smrow o ulong d ulong to void
m = get fa o
for k ulong d
m = fmax m get fa add o k
end
s = 0.0f32
for k ulong d
e = f32 oal_expf f64 sub get fa add o k m
put fo add o k e
s = add s e
end
for k ulong d
put fo add o k div get fo add o k s
end
end
fn kern to void
d = get kd 0
for i ulong get kr 0
smrow mul i d d
end
end
fn main to int
oal_begin
put kr 0 ulong oal_p 0
put kd 0 ulong oal_p 1
a = oal_fa 0
w = oal_warm
for i ulong add w oal_reps
t0 = monons
kern
t1 = monons
if ge i w
oal_tick sub t1 t0
end
end
oal_so 0 a
oal_end
ret 0
end
